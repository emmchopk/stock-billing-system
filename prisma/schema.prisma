generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id            Int            @id @default(autoincrement())
  name          String
  phone         String?
  email         String?
  address       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  billingNotes  BillingNote[]
  deliveryNotes DeliveryNote[]
  invoices      Invoice[]
  pickingLists  PickingList[]
  receipts      Receipt[]
}

model Product {
  id            Int                @id @default(autoincrement())
  name          String
  sku           String?            @unique
  description   String?
  costPrice     Float              @default(0)
  salePrice     Float              @default(0)
  stock         Int                @default(0)
  unit          String?
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deliveryItems DeliveryNoteItem[]
  invoiceItems  InvoiceItem[]
  pickingItems  PickingListItem[]
  receiptItems  ReceiptItem[]
}

model PickingList {
  id         Int               @id @default(autoincrement())
  documentNo String            @unique
  customerId Int?
  status     PickingStatus     @default(DRAFT)
  note       String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  customer   Customer?         @relation(fields: [customerId], references: [id])
  items      PickingListItem[]
}

model PickingListItem {
  id            Int         @id @default(autoincrement())
  pickingListId Int
  productId     Int
  quantity      Int         @default(1)
  note          String?
  pickingList   PickingList @relation(fields: [pickingListId], references: [id], onDelete: Cascade)
  product       Product     @relation(fields: [productId], references: [id])
}

model DeliveryNote {
  id              Int                @id @default(autoincrement())
  documentNo      String             @unique
  customerId      Int?
  deliveryDate    DateTime           @default(now())
  status          DeliveryStatus     @default(DRAFT)
  receiverName    String?
  receiverPhone   String?
  deliveryAddress String?
  note            String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  customer        Customer?          @relation(fields: [customerId], references: [id])
  items           DeliveryNoteItem[]
}

model DeliveryNoteItem {
  id             Int          @id @default(autoincrement())
  deliveryNoteId Int
  productId      Int
  quantity       Int          @default(1)
  note           String?
  deliveryNote   DeliveryNote @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id])
}

model BillingNote {
  id          Int           @id @default(autoincrement())
  documentNo  String        @unique
  customerId  Int?
  billingDate DateTime      @default(now())
  dueDate     DateTime?
  subtotal    Float         @default(0)
  discount    Float         @default(0)
  vat         Float         @default(0)
  totalAmount Float         @default(0)
  status      BillingStatus @default(DRAFT)
  note        String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  customer    Customer?     @relation(fields: [customerId], references: [id])
  invoices    Invoice[]
}

model Invoice {
  id            Int           @id @default(autoincrement())
  documentNo    String        @unique
  customerId    Int?
  billingNoteId Int?
  invoiceDate   DateTime      @default(now())
  dueDate       DateTime?
  subtotal      Float         @default(0)
  discount      Float         @default(0)
  vat           Float         @default(0)
  totalAmount   Float         @default(0)
  paidAmount    Float         @default(0)
  balanceDue    Float         @default(0)
  status        InvoiceStatus @default(DRAFT)
  note          String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  billingNote   BillingNote?  @relation(fields: [billingNoteId], references: [id])
  customer      Customer?     @relation(fields: [customerId], references: [id])
  items         InvoiceItem[]
  receipts      Receipt[]
}

model InvoiceItem {
  id          Int      @id @default(autoincrement())
  invoiceId   Int
  productId   Int?
  productName String
  quantity    Int      @default(1)
  costPrice   Float    @default(0)
  unitPrice   Float    @default(0)
  totalCost   Float    @default(0)
  totalPrice  Float    @default(0)
  note        String?
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])
}

model Receipt {
  id            Int           @id @default(autoincrement())
  documentNo    String        @unique
  customerId    Int?
  invoiceId     Int?
  receiptDate   DateTime      @default(now())
  subtotal      Float         @default(0)
  discount      Float         @default(0)
  vat           Float         @default(0)
  totalAmount   Float         @default(0)
  paymentMethod PaymentMethod @default(CASH)
  paymentRef    String?
  note          String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  customer      Customer?     @relation(fields: [customerId], references: [id])
  invoice       Invoice?      @relation(fields: [invoiceId], references: [id])
  items         ReceiptItem[]
}

model ReceiptItem {
  id          Int      @id @default(autoincrement())
  receiptId   Int
  productId   Int?
  productName String
  quantity    Int      @default(1)
  costPrice   Float    @default(0)
  unitPrice   Float    @default(0)
  totalCost   Float    @default(0)
  totalPrice  Float    @default(0)
  note        String?
  product     Product? @relation(fields: [productId], references: [id])
  receipt     Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
}

model Expense {
  id          Int             @id @default(autoincrement())
  title       String
  category    ExpenseCategory @default(OTHER)
  amount      Float           @default(0)
  expenseDate DateTime        @default(now())
  note        String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

enum PickingStatus {
  DRAFT
  PICKING
  COMPLETED
  CANCELLED
}

enum DeliveryStatus {
  DRAFT
  DELIVERING
  DELIVERED
  CANCELLED
}

enum BillingStatus {
  DRAFT
  WAITING_PAYMENT
  PAID
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  UNPAID
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
  CREDIT_CARD
  QR
  OTHER
}

enum ExpenseCategory {
  PRODUCT_COST
  SHIPPING
  PACKAGING
  SALARY
  RENT
  MARKETING
  OTHER
}
